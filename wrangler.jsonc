{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "km-promotions-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ADMIN_EMAIL": "munachimsokenneth@gmail.com" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "km-promotions-db",
      "database_id": "163cc83e-5889-4246-8f60-9991fd741c25"
    }
  ]
}
